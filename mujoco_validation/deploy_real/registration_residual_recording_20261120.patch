+#pragma once
+// Always-on evidence from the actual quality decision. One producer and one
+// background disk worker; recording never publishes or admits sensor data.
+#include "registration_core.hpp"
+#include "json.hpp"
+#include <atomic>
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <thread>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <fcntl.h>
+#include <unistd.h>
+
+namespace gos6d {
+class RegistrationEvidence {
+    static constexpr std::size_t capacity=64,segments=4,segment_bytes=8*1024*1024;
+    struct Event {
+        double wall=0,mono=0,stamp=0,pair_delta=0,p95=0,threshold=0,age=0;
+        std::int32_t sec=0;std::uint32_t nanosec=0;
+        std::uint64_t check=0,matched=0,forwarded=0,roi=0,reference=0;
+        int oldest=0,newest=0,code=0;
+        bool checked=false,quality_ok=false;
+        Vec position=Vec::Zero();Eigen::Vector4d orientation{0,0,0,1};
+        char reason[96]{};
+        std::array<DecisionResidualSample,128> samples{};std::size_t count=0;
+    };
+    std::unique_ptr<Event[]> queue_{new Event[capacity]};
+    std::atomic<std::uint64_t> head_{0},tail_{0},dropped_{0};
+    std::atomic<bool> stopping_{false},failed_{false};
+    std::thread worker_;std::filesystem::path directory_;
+    std::uint64_t last_check_=0;std::size_t segment_=0,bytes_=0;
+    int fd_=-1;bool first_rejection_saved_=false;
+    static nlohmann::json number(double v){return std::isfinite(v)?nlohmann::json(v):nlohmann::json();}
+    static nlohmann::json xyz(const Vec& p){return {p.x(),p.y(),p.z()};}
+    static nlohmann::json encode(const Event& e){
+        using J=nlohmann::json;
+        J j={{"schema",1},{"event","registration_quality"},{"wall_s",e.wall},{"mono_s",e.mono},
+            {"source_stamp_s",e.stamp},{"source_sec",e.sec},{"source_nanosec",e.nanosec},
+            {"source_age_s",e.age},{"pair_delta_s",number(e.pair_delta)},
+            {"decision",e.reason},{"decision_code",e.code},{"quality_checked",e.checked},
+            {"quality_check",e.check},{"quality_ok",e.quality_ok},{"matched",e.matched},{"forwarded",e.forwarded},
+            {"position",xyz(e.position)},{"orientation_xyzw",{e.orientation[0],e.orientation[1],e.orientation[2],e.orientation[3]}}};
+        if(e.checked){
+            j["p95_m"]=number(e.p95);j["p95_finite"]=std::isfinite(e.p95);j["threshold_m"]=e.threshold;
+            j["roi_points"]=e.roi;j["reference_points"]=e.reference;
+            j["reference_oldest_matched"]=e.oldest;j["reference_newest_matched"]=e.newest;
+            j["samples"]=J::array();
+            for(std::size_t i=0;i<e.count;++i){const auto& s=e.samples[i];
+                j["samples"].push_back({{"source_world",xyz(s.source)},
+                    {"nearest_world",s.found?xyz(s.nearest):J()},
+                    {"found",s.found},{"distance_m",number(s.distance)}});}
+        }
+        return j;
+    }
+    static bool write_all(int fd,const std::string& s){
+        auto* p=s.data();auto left=s.size();
+        while(left){auto n=::write(fd,p,left);if(n<0&&errno==EINTR)continue;if(n<=0)return false;p+=n;left-=n;}
+        return true;
+    }
+    void open_segment(){
+        if(fd_>=0){if(::fsync(fd_)!=0)throw std::runtime_error("evidence sync");::close(fd_);}
+        const auto p=directory_/("segment_"+std::to_string(segment_)+".jsonl");
+        fd_=::open(p.c_str(),O_WRONLY|O_CREAT|O_TRUNC|O_NOFOLLOW|O_CLOEXEC,0600);
+        if(fd_<0)throw std::runtime_error("evidence open");bytes_=0;
+    }
+    void work()noexcept{
+        try{
+            double last_sync=0;
+            while(!stopping_||tail_.load()!=head_.load()){
+                const auto t=tail_.load(std::memory_order_relaxed);
+                if(t==head_.load(std::memory_order_acquire)){
+                    if(bytes_&&last_sync>0){
+                        auto now=std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+                        if(now-last_sync>1){if(::fsync(fd_)!=0)throw std::runtime_error("evidence sync");last_sync=now;}}
+                    std::this_thread::sleep_for(std::chrono::milliseconds(5));continue;}
+                const auto e=queue_[t%capacity];tail_.store(t+1,std::memory_order_release);
+                const auto row=encode(e).dump()+"\n";
+                if(row.size()>segment_bytes)throw std::runtime_error("evidence record size");
+                if(bytes_+row.size()>segment_bytes){segment_=(segment_+1)%segments;open_segment();}
+                if(!write_all(fd_,row))throw std::runtime_error("evidence write");bytes_+=row.size();
+                if(e.code==RegistrationDecision::Reject&&!first_rejection_saved_){
+                    const auto p=directory_/"first_rejection.json";
+                    const int first=::open(p.c_str(),O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW|O_CLOEXEC,0600);
+                    if(first<0)throw std::runtime_error("first evidence open");
+                    const bool ok=write_all(first,row)&&::fsync(first)==0;::close(first);
+                    if(!ok)throw std::runtime_error("first evidence write");first_rejection_saved_=true;
+                }
+                if(e.mono-last_sync>1){if(::fsync(fd_)!=0)throw std::runtime_error("evidence sync");last_sync=e.mono;}
+            }
+            if(::fsync(fd_)!=0)throw std::runtime_error("evidence final sync");
+        }catch(...){failed_=true;std::fprintf(stderr,"[REGISTRATION_EVIDENCE_FAILED] inspect evidence_write_failed status\n");}
+    }
+public:
+    explicit RegistrationEvidence(const std::string& path):directory_(path){
+        if(!std::filesystem::create_directory(directory_))throw std::runtime_error("new registration evidence directory required");
+        ::chmod(directory_.c_str(),0700);struct statvfs v{};
+        if(::statvfs(directory_.c_str(),&v)!=0||double(v.f_bavail)*v.f_frsize<128*1024*1024)
+            throw std::runtime_error("registration evidence disk reserve");
+        open_segment();worker_=std::thread([this]{work();});
+    }
+    ~RegistrationEvidence(){stopping_=true;if(worker_.joinable())worker_.join();if(fd_>=0)::close(fd_);}
+    bool failed()const{return failed_.load();}
+    std::uint64_t dropped()const{return dropped_.load();}
+    void record(const RegistrationCore& core,const RegistrationDecision& decision,double wall,double mono){
+        const bool checked=core.state.quality_checks!=last_check_;
+        last_check_=core.state.quality_checks;
+        if(!checked&&decision.code!=RegistrationDecision::Reject)return;
+        if(failed_)return;
+        const auto h=head_.load(std::memory_order_relaxed);
+        if(h-tail_.load(std::memory_order_acquire)>=capacity){++dropped_;return;}
+        auto& e=queue_[h%capacity];e=Event{};
+        const auto& s=core.state;e.wall=wall;e.mono=mono;e.stamp=core.selected_cloud->stamp;e.age=wall-e.stamp;
+        if(core.selected_cloud->source_stamp){e.sec=core.selected_cloud->source_stamp->sec;e.nanosec=core.selected_cloud->source_stamp->nanosec;}
+        e.pair_delta=core.selected_pair_delta;e.code=decision.code;e.checked=checked;e.check=s.quality_checks;
+        e.quality_ok=s.quality_ok;e.matched=s.matched;e.forwarded=s.forwarded;
+        std::strncpy(e.reason,decision.reason.c_str(),sizeof(e.reason)-1);
+        if(core.selected_odom){e.position=core.selected_odom->position;e.orientation=core.selected_odom->q;}
+        if(checked){e.p95=s.last_residual;e.threshold=core.profile.residual_max;
+            e.roi=s.quality_roi_points;e.reference=s.quality_reference_points;
+            e.oldest=s.quality_reference_oldest;e.newest=s.quality_reference_newest;
+            e.count=std::min(e.samples.size(),s.residual_samples.size());
+            std::copy_n(s.residual_samples.begin(),e.count,e.samples.begin());}
+        head_.store(h+1,std::memory_order_release);
+    }
+};
+}
