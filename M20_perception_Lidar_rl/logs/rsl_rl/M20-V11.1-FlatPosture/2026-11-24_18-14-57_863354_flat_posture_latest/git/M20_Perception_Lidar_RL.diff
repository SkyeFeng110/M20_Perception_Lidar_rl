+def compatible_observation_contract(saved, teacher):
+    """Accept the equivalent executed-wheel-history deployment term.
+
+    FlatStart's stopped-wheel action stores the postprocessed action under
+    ``executed_last_action``. It has the same 16 values and actor dimension as
+    the native ``last_action`` term; every other observation field must remain
+    byte-for-byte identical.
+    """
+    if set(saved) != set(teacher):
+        return False
+    for key in saved:
+        a, b = saved[key], teacher[key]
+        if key != 'actions':
+            if a != b:
+                return False
+            continue
+        if {a.get('func', '').split(':')[-1], b.get('func', '').split(':')[-1]} \
+                - {'last_action', 'executed_last_action'}:
+            return False
+        aa, bb = dict(a), dict(b)
+        aa.pop('func', None); bb.pop('func', None)
+        if aa != bb:
+            return False
+    return True
+
+
